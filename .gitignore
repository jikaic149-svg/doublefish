# macOS archive metadata
.DS_Store
._*
__MACOSX/

# Local IDE settings
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/robofish-ota.ps1
!.vscode/launch.json

# Local ESP-IDF work files and timestamped OTA exports
RoboFishPartnerDriverSDK/sdkconfig
RoboFishPartnerDriverSDK/build/idf/
RoboFishPartnerDriverSDK/build/*-idf/
RoboFishPartnerDriverSDK/build/RoboFishPartnerDriverSDK-OTA-*.bin
RoboFishPartnerDriverSDK/managed_components/

# Temporary files
*.tmp
*.log
.codex_camera_probe.jpg
.codex_tmp/

# Local Python/YOLO environments and generated caches
.env
**/.env
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
**/.matplotlib/
**/.ultralytics/
Ultralytics/
VISION/Ultralytics/
VISION/configs/marker_profile.local.json
VISION/configs/turn_calibration.local.json
VISION/configs/.marker_profile.test.json
output/vision/

# Vision media, extracted frames, and training runs are local artifacts.
# Keep the small metadata and processing scripts under VISION/training tracked.
/VISION.zip
VISION/data/raw/*.mp4
VISION/data/results/*.mp4
VISION/models/candidates/*.pt
VISION/training/fish_v15/dataset_v15_reviewed_large/images/
VISION/training/fish_v15/runs/

# Local reverse-engineering tool environment
reverse_analysis/.tools/

# Rizin project databases embed workstation-specific absolute paths
reverse_analysis/disassembly/*.rzdb
